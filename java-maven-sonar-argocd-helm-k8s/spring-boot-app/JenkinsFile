pipeline {
    agent {
        docker {
            image 'maven:3.9.11-eclipse-temurin-11'
            args '--user root'
        }
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'echo Checkout stage passed'
            }
        }
        stage('Build') {
            steps {
                sh '''
                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                    mvn clean compile
                '''
                sh 'echo Build stage passed'
            }
        }
        stage('Unit Test') {
            steps {
                sh '''
                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                    mvn test
                '''
                sh 'echo Unit Test stage passed'
            }
        }
    }
}