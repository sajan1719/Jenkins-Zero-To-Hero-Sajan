pipeline {
    agent {
        label 'built-in'
    }

    environment {
        DOCKER_IMAGE = "sajancoder1719/spring-boot-app:${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                sh 'echo Checkout stage passed'
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                    mvn clean package
                '''

                sh 'echo Build and Test stage passed'
            }
        }

        stage('Static Code Analysis') {
            environment {
                SONAR_URL = "http://localhost:9000"
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonar-new-token',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    sh '''
                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                          -Dsonar.token=$SONAR_AUTH_TOKEN \
                          -Dsonar.host.url=$SONAR_URL
                    '''

                    sh 'echo Static Code Analysis stage passed'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    cd java-maven-sonar-argocd-helm-k8s/spring-boot-app

                    docker build -t $DOCKER_IMAGE .
                '''

                sh 'echo Docker Build stage passed'
            }
        }

        stage('Snyk Image Scan') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'snyk-token',
                        variable: 'SNYK_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "Starting Snyk container scan..."

                        snyk container test $DOCKER_IMAGE \
                            --file=java-maven-sonar-argocd-helm-k8s/spring-boot-app/Dockerfile \
                            --severity-threshold=high
                    '''
                }

                sh 'echo Snyk Image Scan stage passed'
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'docker-cred',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        docker push $DOCKER_IMAGE

                        docker logout
                    '''
                }

                sh 'echo Docker Push stage passed'
            }
        }
    }
}